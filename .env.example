SECRET_KEY=ganti-dengan-string-random-panjang
SHOP_NAME=PrintShop L3110
SHOP_PHONE=08xxxxxxxxxx
SHOP_ADDRESS=Jl. Contoh No. 1
ADMIN_USER=admin
ADMIN_PASS=ganti-password-ini
HOST=0.0.0.0
PORT=8088
DATABASE_PATH=data/printshop.db
UPLOAD_DIR=data/uploads
# Optional: nama queue CUPS untuk auto-print (kosong = auto-detect / agent)
CUPS_PRINTER=
# auto | bw | color
PRINT_COLOR_MODE=auto
# status yang memicu auto enqueue print
AUTO_PRINT_ON_STATUS=antrian,proses
# coba print lokal dulu jika CUPS ada di mesin app
AUTO_PRINT_LOCAL=true
# token agent di PC toko (WAJIB diganti)
PRINT_AGENT_TOKEN=ganti-token-ini
TIMEZONE=Asia/Jakarta
# ---- Payment gateway (QRIS via Midtrans) ----
# kosongkan PAYMENT_PROVIDER untuk mematikan pembayaran online (manual/COD)
PAYMENT_PROVIDER=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
PAYMENT_PAID_STATUS=antrian
