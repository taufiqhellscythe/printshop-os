# ==============================
# PrintShop Windows Agent Config
# Edit file ini, lalu jalankan start.bat
# ==============================

# Alamat server PrintShop OS (VPS kamu)
PRINTSHOP_URL=http://129.226.135.26:8088

# HARUS sama dengan PRINT_AGENT_TOKEN di server (.env)
PRINT_AGENT_TOKEN=print-agent-change-me

# Nama printer Windows persis (lihat di Settings → Printers)
# Kosongkan = pakai default printer Windows
PRINTER_NAME=Epson L3110 Series

# Nama worker (bebas, biar kelihatan di log)
PRINT_WORKER_NAME=PC-TOKO-1

# Interval poll (detik)
PRINT_POLL_INTERVAL=2

# Opsional: path SumatraPDF.exe (recommended buat PDF silent print)
# SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe
